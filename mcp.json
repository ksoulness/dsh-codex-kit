{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "harness-relay-mcp": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/scripts/relay-proxy.mjs"],
      "cwd": "${PLUGIN_ROOT}"
    },
    "dsh-session-archive": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/scripts/session-archive-mcp.mjs"],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
